# Copy to .env for a local run. Every variable below is read at start and has no default unless
# marked optional; a missing one stops the service. Secrets are blank on purpose: fill them from
# the secret store, never commit the filled-in file. Values shown are the lab's (kinetix-infrastructure
# compose.yaml, x-notification-env).

GRPC_PORT=50057
HTTP_PORT=8004

IDENTITY_GRPC_URL=kinetix-identity-service:50052
IDENTITY_JWKS_URL=http://kinetix-identity-service:5000/.well-known/jwks.json
JWT_ISSUER=https://identity.kinetix.local
JWT_AUDIENCE=kinetix

# Read by the migrator as well, and the only three it reads.
DATABASE_URL=jdbc:postgresql://kinetix-notification-db:5432/kinetix_notification_dev
DB_USERNAME=kinetix_notification_app
DB_PASSWORD=

# https://fcm.googleapis.com/v1/projects/<firebase project id>/messages:send
PUSH_PROVIDER_URL=
# base64 of the Firebase service account JSON key
PUSH_PROVIDER_CREDENTIALS_B64=

EMAIL_PROVIDER_URL=https://api.resend.com/emails
EMAIL_PROVIDER_KEY=
# An address on the domain verified with Resend.
EMAIL_FROM_ADDRESS=

KINETIX_PKI_DIR=/pki

# Must be set even when empty: empty grants nobody.
KINETIX_GRPC_ALLOWED_PEERS=notary@notification.v1.NotificationService/Notify
KINETIX_NOTIFICATION_TEMPLATE_GRANTS=notary:TEMPLATE_LIABILITY_STATEMENT

# A whole number of at least 1; one more handset forgets the least recently registered.
MAX_DEVICES_PER_PRINCIPAL=10

# Optional. Unset trusts kinetix.local; a comma-separated list is accepted during a cutover.
KINETIX_TRUST_DOMAIN=kinetix.local
# Optional. logback's root level; unset is INFO.
LOG_LEVEL=info
# Optional. Baked into the image from the build's SERVICE_VERSION; unset reports "unknown".
KINETIX_SERVICE_VERSION=

# Tests only: PostgresStoreSuite truncates this database, so its name must contain "test".
NOTIFICATION_TEST_DATABASE_URL=jdbc:postgresql://localhost:5432/notification_test
NOTIFICATION_TEST_DB_USERNAME=
NOTIFICATION_TEST_DB_PASSWORD=
